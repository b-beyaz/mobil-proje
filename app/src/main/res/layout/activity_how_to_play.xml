<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.HowToPlayActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar5"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@color/toolbarRenk"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Geri Butonu -->
    <ImageButton
        android:id="@+id/homeButtonDon"
        android:layout_width="74dp"
        android:layout_height="59dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="4dp"
        android:background="@null"
        android:contentDescription="@string/home_page"
        android:padding="0dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/home_resim"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Başlık -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/pacifico"
        android:text="@string/app_name"
        android:textColor="@color/textPrimary"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@id/toolbar5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar5" />

    <!-- Alt Başlık -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/howto_play_title"
        android:textColor="@color/textRenk"
        android:textSize="32sp"
        android:textAlignment="center"
        android:fontFamily="@font/pacifico"
        app:layout_constraintTop_toBottomOf="@id/toolbar5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp" />

    <!-- Görsel -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="246dp"
        android:layout_height="189dp"
        android:layout_marginTop="25dp"
        app:srcCompat="@drawable/bomba_resim_2"
        app:layout_constraintTop_toBottomOf="@id/textView7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ScrollView ile metin -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtHtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textRenk"
            android:justificationMode="inter_word"
            android:padding="16dp"
            android:text="@string/howto_play_text"
            android:textSize="18sp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
