<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Veritabanı test yazısı -->
    <TextView
        android:id="@+id/databaseTest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Boş"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:onClick="howToPlay"/>


    <!-- Hoş Geldiniz Yazısı -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oyuna Hoş Geldiniz!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="150dp" />

    <!-- Kolay Butonu -->
    <Button
        android:id="@+id/easyButton"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:text="Kolay"
        android:textColor="@color/black"
        android:textSize="30sp"
        android:backgroundTint="@color/blue"
        app:layout_constraintTop_toBottomOf="@id/welcomeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp" />

    <!-- Orta Butonu -->
    <Button
        android:id="@+id/mediumButton"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:text="Orta"
        android:textSize="30sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/blue"
        app:layout_constraintTop_toBottomOf="@id/easyButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Zor Butonu -->
    <Button
        android:id="@+id/hardButton"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:text="Zor"
        android:textSize="30sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/blue"
        app:layout_constraintTop_toBottomOf="@id/mediumButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>